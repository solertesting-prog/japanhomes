// =============================================================================
// JAPAN PROPERTY TOKEN — PostgreSQL data model
// =============================================================================
// Conventions
//  * Money: integer JPY in BigInt. Never Float/Decimal for money.
//  * Rates: integer basis points (Int, 10000 = 100 %).
//  * Token quantities: BigInt (whole tokens; no fractional tokens).
//  * Ownership shares: integer parts-per-million where needed.
//  * FX rates are the only Decimal values and are never used to store money.
//  * Timestamps: timestamptz(3), UTC.
//  * PII that is not needed for querying is encrypted at the application layer
//    (AES-256-GCM, envelope keys in KMS) and stored as Bytes (*Enc columns).
//  * Ids: UUID v4 generated by the application.
//  * Extra invariants Prisma cannot express (CHECK constraints, append-only audit
//    log, balanced journal entries) live in the SQL migrations.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// -----------------------------------------------------------------------------
// Identity, access, sessions
// -----------------------------------------------------------------------------

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed.
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @db.Timestamptz(3)
  /// scrypt hash (format scrypt$N$r$p$salt$hash). Never the password.
  passwordHash      String     @db.VarChar(255)
  status            UserStatus @default(ACTIVE)
  mfaEnabled        Boolean    @default(false)
  /// TOTP secret, encrypted.
  mfaSecretEnc      Bytes?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz(3)
  lastLoginAt       DateTime?  @db.Timestamptz(3)
  locale            String     @default("en") @db.VarChar(5)
  timezone          String     @default("Asia/Tokyo") @db.VarChar(64)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  profile             UserProfile?
  roles               UserRole[]   @relation("UserRoles")
  grantedRoles        UserRole[]   @relation("RoleGrantedBy")
  sessions            Session[]
  authTokens          AuthToken[]
  kycVerifications    KycVerification[] @relation("KycSubject")
  kycReviews          KycVerification[] @relation("KycReviewer")
  eligibilities       InvestorEligibility[]
  consents            Consent[]
  beneficialOwners    BeneficialOwner[]
  wallets             Wallet[]
  subscriptionOrders  SubscriptionOrder[]
  investments         Investment[]
  tokenAllocations    TokenAllocation[]
  distributionAllocs  DistributionAllocation[]
  secondaryOrders     SecondaryMarketOrder[]
  transactions        Transaction[]
  notifications       Notification[]
  favorites           FavoriteProperty[]
  auditLogs           AuditLog[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted legal name as on the identity document.
  legalNameEnc        Bytes?
  dateOfBirthEnc      Bytes?
  addressEnc          Bytes?
  phoneEnc            Bytes?
  /// ISO 3166-1 alpha-2. Kept in clear: eligibility rules query on it.
  nationality         String?   @db.Char(2)
  countryOfResidence  String?   @db.Char(2)
  isEntity            Boolean   @default(false)
  piiKeyVersion       Int       @default(1)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([countryOfResidence])
  @@map("user_profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         RoleKey          @unique
  name        String           @db.VarChar(80)
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  /// e.g. "property:write", "kyc:review", "distribution:approve"
  key         String           @unique @db.VarChar(80)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  user        User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedById String?   @db.Uuid
  grantedBy   User?     @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque session token; the token itself is only in the cookie.
  tokenHash     String    @unique @db.Char(64)
  userAgent     String?   @db.VarChar(512)
  /// Keyed hash of the IP address (not the raw IP).
  ipHash        String?   @db.Char(64)
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique @db.Char(64)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, type])
  @@map("auth_tokens")
}

// -----------------------------------------------------------------------------
// KYC / AML / eligibility
// -----------------------------------------------------------------------------

model KycVerification {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  user              User       @relation("KycSubject", fields: [userId], references: [id], onDelete: Restrict)
  /// Adapter key, e.g. "mock", or a real provider once contracted.
  provider          String     @db.VarChar(40)
  providerReference String?    @db.VarChar(120)
  status            KycStatus  @default(NOT_STARTED)
  level             String     @default("standard") @db.VarChar(40)
  riskScore         Int?
  pepMatch          Boolean    @default(false)
  sanctionsMatch    Boolean    @default(false)
  submittedAt       DateTime?  @db.Timestamptz(3)
  reviewedAt        DateTime?  @db.Timestamptz(3)
  reviewedById      String?    @db.Uuid
  reviewedBy        User?      @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  decisionReason    String?
  expiresAt         DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  checks KycCheck[]

  @@unique([provider, providerReference])
  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("kyc_verifications")
}

model KycCheck {
  id             String          @id @default(uuid()) @db.Uuid
  verificationId String          @db.Uuid
  verification   KycVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  type           KycCheckType
  result         KycCheckResult
  /// Pointer to the provider payload in encrypted object storage (never inline PII).
  evidenceKey    String?         @db.VarChar(512)
  summary        String?
  checkedAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([verificationId])
  @@map("kyc_checks")
}

model BeneficialOwner {
  id                 String   @id @default(uuid()) @db.Uuid
  /// The entity investor this person ultimately owns or controls.
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameEnc            Bytes
  ownershipBps       Int
  countryOfResidence String   @db.Char(2)
  isControllingPerson Boolean @default(false)
  verifiedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("beneficial_owners")
}

model InvestorEligibility {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String           @db.Uuid
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO 3166-1 alpha-2 jurisdiction the assessment was made for.
  jurisdiction             String           @db.Char(2)
  category                 InvestorCategory @default(RETAIL)
  isEligible               Boolean
  /// Machine-readable rule results, e.g. [{ rule: "RESIDENCY_ALLOWED", passed: true }].
  ruleResults              Json
  ruleSetVersion           String           @db.VarChar(40)
  maxInvestmentPerOffering BigInt?
  assessedAt               DateTime         @default(now()) @db.Timestamptz(3)
  assessedById             String?          @db.Uuid
  validUntil               DateTime?        @db.Timestamptz(3)

  @@index([userId, assessedAt])
  @@map("investor_eligibilities")
}

model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  /// Version of the legal text accepted.
  version     String      @db.VarChar(40)
  acceptedAt  DateTime    @default(now()) @db.Timestamptz(3)
  ipHash      String?     @db.Char(64)
  userAgent   String?     @db.VarChar(512)
  withdrawnAt DateTime?   @db.Timestamptz(3)

  @@index([userId, type])
  @@map("consents")
}

// -----------------------------------------------------------------------------
// Legal entities and real estate
// -----------------------------------------------------------------------------

model LegalEntity {
  id                String          @id @default(uuid()) @db.Uuid
  name              String          @db.VarChar(200)
  nameJa            String?         @db.VarChar(200)
  type              LegalEntityType
  role              LegalEntityRole
  /// 法人番号 (13 digits) for Japanese entities.
  corporateNumber   String?         @unique @db.Char(13)
  registeredAddress String?
  /// Licences/registrations held, e.g. [{ "type": "FIEA_TYPE_II", "number": "..." }].
  licenses          Json            @default("[]")
  isDemo            Boolean         @default(false)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  ownerships PropertyOwnership[]
  offerings  TokenOffering[]

  @@map("legal_entities")
}

model Property {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique @db.VarChar(120)
  isDemo             Boolean           @default(false)
  status             PropertyStatus    @default(DRAFT)
  name               String            @db.VarChar(160)
  city               City
  prefecture         Prefecture
  neighborhood       String            @db.VarChar(120)
  /// Ward/district-level address shown publicly.
  approximateAddress String            @db.VarChar(255)
  /// Full registered address, encrypted; staff only.
  exactAddressEnc    Bytes?
  /// Rounded coordinates for the public map (~1 km).
  latitude           Decimal           @db.Decimal(8, 5)
  longitude          Decimal           @db.Decimal(8, 5)
  type               PropertyType
  layout             String?           @db.VarChar(80)
  structure          String            @db.VarChar(160)
  floorAreaM2        Decimal           @db.Decimal(10, 2)
  landAreaM2         Decimal?          @db.Decimal(10, 2)
  yearBuilt          Int
  nearestStation     String            @db.VarChar(120)
  walkMinutes        Int
  condition          PropertyCondition
  rentalStatus       RentalStatus
  summary            String            @db.VarChar(400)
  description        String
  highlights         String[]
  featured           Boolean           @default(false)
  publishedAt        DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  translations PropertyTranslation[]
  images       PropertyImage[]
  documents    PropertyDocument[]
  valuations   PropertyValuation[]
  financials   PropertyFinancial[]
  ownerships   PropertyOwnership[]
  risks        PropertyRisk[]
  offerings    TokenOffering[]
  rentalIncome RentalIncome[]
  expenses     PropertyExpense[]
  favorites    FavoriteProperty[]

  @@index([status, city])
  @@index([status, type])
  @@index([status, featured, publishedAt])
  @@map("properties")
}

model PropertyTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(5)
  name        String   @db.VarChar(160)
  summary     String   @db.VarChar(400)
  description String
  highlights  String[]

  @@unique([propertyId, locale])
  @@map("property_translations")
}

model PropertyRisk {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String    @db.VarChar(160)
  detail     String
  level      RiskLevel
  sortOrder  Int       @default(0)

  @@index([propertyId, sortOrder])
  @@map("property_risks")
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storageKey String   @db.VarChar(512)
  alt        String   @db.VarChar(255)
  width      Int
  height     Int
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

model PropertyDocument {
  id           String              @id @default(uuid()) @db.Uuid
  propertyId   String              @db.Uuid
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  offeringId   String?             @db.Uuid
  offering     TokenOffering?      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  type         DocumentType
  title        String              @db.VarChar(200)
  accessLevel  DocumentAccessLevel @default(VERIFIED)
  /// Private bucket key. Files are served through short-lived signed URLs only.
  storageKey   String              @db.VarChar(512)
  mimeType     String              @db.VarChar(100)
  sizeBytes    Int
  /// Hex SHA-256 of the file: what the investor accepted is provable.
  sha256       String              @db.Char(64)
  version      Int                 @default(1)
  publishedAt  DateTime?           @db.Timestamptz(3)
  uploadedById String?             @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  acceptances OrderDocumentAcceptance[]

  @@unique([propertyId, type, version])
  @@index([offeringId])
  @@map("property_documents")
}

model PropertyValuation {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @db.Uuid
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  appraisedValue BigInt
  method         String   @db.VarChar(160)
  appraiser      String   @db.VarChar(200)
  appraisedAt    DateTime @db.Timestamptz(3)
  reportDocumentId String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, appraisedAt])
  @@map("property_valuations")
}

/// Versioned underwriting assumptions. One row is current per property.
model PropertyFinancial {
  id                       String    @id @default(uuid()) @db.Uuid
  propertyId               String    @db.Uuid
  property                 Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  version                  Int
  isCurrent                Boolean   @default(false)
  purchasePrice            BigInt
  acquisitionCosts         BigInt    @default(0)
  renovationCosts          BigInt    @default(0)
  reserves                 BigInt    @default(0)
  annualGrossRent          BigInt
  occupancyBps             Int
  annualOperatingExpenses  BigInt
  annualPropertyTax        BigInt
  propertyManagementFeeBps Int
  platformFeeBps           Int
  subscriptionFeeBps       Int
  notes                    String?
  createdById              String?   @db.Uuid
  approvedById             String?   @db.Uuid
  approvedAt               DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([propertyId, version])
  @@index([propertyId, isCurrent])
  @@map("property_financials")
}

/// Who holds which interest in the building (title vs trust vs beneficiary).
model PropertyOwnership {
  id               String        @id @default(uuid()) @db.Uuid
  propertyId       String        @db.Uuid
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  legalEntityId    String        @db.Uuid
  legalEntity      LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  ownershipType    OwnershipType
  shareBps         Int           @default(10000)
  /// Real estate registry (登記) reference, if applicable.
  registryReference String?      @db.VarChar(120)
  validFrom        DateTime      @db.Timestamptz(3)
  validTo          DateTime?     @db.Timestamptz(3)

  @@index([propertyId, validTo])
  @@map("property_ownerships")
}

model FavoriteProperty {
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("favorite_properties")
}

// -----------------------------------------------------------------------------
// Tokenisation
// -----------------------------------------------------------------------------

model TokenOffering {
  id                   String         @id @default(uuid()) @db.Uuid
  propertyId           String         @db.Uuid
  property             Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  issuerEntityId       String         @db.Uuid
  issuerEntity         LegalEntity    @relation(fields: [issuerEntityId], references: [id], onDelete: Restrict)
  financialId          String?        @db.Uuid
  isDemo               Boolean        @default(false)
  legalStructure       LegalStructure
  status               OfferingStatus @default(DRAFT)
  tokenName            String         @db.VarChar(120)
  tokenSymbol          String         @unique @db.VarChar(16)
  totalTokens          BigInt
  tokenPrice           BigInt
  /// Maintained transactionally with allocations; CHECK keeps sold+reserved ≤ total.
  tokensSold           BigInt         @default(0)
  tokensReserved       BigInt         @default(0)
  minimumInvestment    BigInt
  maximumInvestment    BigInt?
  opensAt              DateTime?      @db.Timestamptz(3)
  closesAt             DateTime?      @db.Timestamptz(3)
  lockupUntil          DateTime?      @db.Timestamptz(3)
  economicRights       String
  transferRestrictions String
  votingRights         String?
  /// Reference to counsel's opinion / licence enabling a real (non-demo) round.
  legalApprovalRef     String?        @db.VarChar(200)
  approvedById         String?        @db.Uuid
  approvedAt           DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  contract           TokenContract?
  documents          PropertyDocument[]
  subscriptionOrders SubscriptionOrder[]
  allocations        TokenAllocation[]
  investments        Investment[]
  distributions      Distribution[]
  secondaryOrders    SecondaryMarketOrder[]
  transactions       Transaction[]

  @@index([propertyId, status])
  @@index([status, opensAt])
  @@map("token_offerings")
}

model TokenContract {
  id                     String         @id @default(uuid()) @db.Uuid
  offeringId             String         @unique @db.Uuid
  offering               TokenOffering  @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  chainId                Int
  network                String         @db.VarChar(60)
  standard               TokenStandard
  status                 ContractStatus @default(PLANNED)
  /// Lower-case 0x address; null until deployed.
  address                String?        @db.VarChar(42)
  identityRegistry       String?        @db.VarChar(42)
  complianceModule       String?        @db.VarChar(42)
  /// Safe multisig that holds admin roles.
  adminMultisig          String?        @db.VarChar(42)
  deployTxHash           String?        @db.VarChar(66)
  deployedBlock          BigInt?
  deployedAt             DateTime?      @db.Timestamptz(3)
  auditReportDocumentId  String?        @db.Uuid
  lastIndexedBlock       BigInt?
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([chainId, address])
  @@map("token_contracts")
}

model Wallet {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  chainId           Int
  address           String       @db.VarChar(42)
  type              WalletType
  status            WalletStatus @default(PENDING_VERIFICATION)
  /// Regulated custodian identifier for custodial wallets. Keys never stored here.
  custodyProvider   String?      @db.VarChar(60)
  custodyReference  String?      @db.VarChar(120)
  /// Signed message proving control of a self-custody wallet.
  ownershipProofAt  DateTime?    @db.Timestamptz(3)
  /// When the wallet was registered in the on-chain identity registry.
  whitelistedAt     DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  allocations TokenAllocation[]

  @@unique([chainId, address])
  @@index([userId])
  @@map("wallets")
}

// -----------------------------------------------------------------------------
// Subscriptions, payments, allocations, positions
// -----------------------------------------------------------------------------

model SubscriptionOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown on receipts, e.g. JPT-2026-000123.
  reference           String             @unique @db.VarChar(32)
  userId              String             @db.Uuid
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  offeringId          String             @db.Uuid
  offering            TokenOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  status              SubscriptionStatus @default(DRAFT)
  tokens              BigInt
  tokenPrice          BigInt
  amount              BigInt
  feeAmount           BigInt             @default(0)
  totalAmount         BigInt
  currency            String             @default("JPY") @db.Char(3)
  /// Client-supplied key; the same key never creates two orders.
  idempotencyKey      String             @db.VarChar(80)
  /// Eligibility + KYC state at the moment of ordering (evidence).
  eligibilitySnapshot Json
  isSimulated         Boolean            @default(true)
  documentsAcceptedAt DateTime?          @db.Timestamptz(3)
  expiresAt           DateTime?          @db.Timestamptz(3)
  cancelledAt         DateTime?          @db.Timestamptz(3)
  cancelReason        String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  documentAcceptances OrderDocumentAcceptance[]
  payments            Payment[]
  allocation          TokenAllocation?

  @@unique([userId, idempotencyKey])
  @@index([offeringId, status])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("subscription_orders")
}

model OrderDocumentAcceptance {
  orderId    String            @db.Uuid
  documentId String            @db.Uuid
  order      SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  document   PropertyDocument  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  /// Copy of the document hash at acceptance time.
  sha256     String            @db.Char(64)
  acceptedAt DateTime          @default(now()) @db.Timestamptz(3)

  @@id([orderId, documentId])
  @@map("order_document_acceptances")
}

model Payment {
  id                       String           @id @default(uuid()) @db.Uuid
  orderId                  String?          @db.Uuid
  order                    SubscriptionOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  direction                PaymentDirection
  purpose                  PaymentPurpose
  /// Adapter key: "mock" in development.
  provider                 String           @db.VarChar(40)
  providerReference        String?          @db.VarChar(120)
  status                   PaymentStatus    @default(CREATED)
  amount                   BigInt
  currency                 String           @default("JPY") @db.Char(3)
  /// Only for cross-currency payments: what the payer actually sent.
  originalAmountMinor      BigInt?
  originalCurrency         String?          @db.Char(3)
  fxRateId                 String?          @db.Uuid
  fxRate                   FxRate?          @relation(fields: [fxRateId], references: [id], onDelete: Restrict)
  idempotencyKey           String           @unique @db.VarChar(80)
  failureCode              String?          @db.VarChar(80)
  refundedAmount           BigInt           @default(0)
  settledAt                DateTime?        @db.Timestamptz(3)
  reconciledAt             DateTime?        @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)

  events                  PaymentTransaction[]
  distributionAllocations DistributionAllocation[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every event seen for a payment. providerEventId dedupes webhook retries.
model PaymentTransaction {
  id                String           @id @default(uuid()) @db.Uuid
  paymentId         String           @db.Uuid
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type              PaymentEventType
  providerEventId   String?          @db.VarChar(120)
  webhookId         String?          @db.Uuid
  webhook           InboundWebhook?  @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  amount            BigInt?
  signatureVerified Boolean          @default(false)
  payload           Json
  occurredAt        DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([paymentId, providerEventId])
  @@index([paymentId, occurredAt])
  @@map("payment_transactions")
}

model InboundWebhook {
  id                String        @id @default(uuid()) @db.Uuid
  provider          String        @db.VarChar(40)
  eventId           String        @db.VarChar(120)
  eventType         String        @db.VarChar(80)
  signatureVerified Boolean
  status            WebhookStatus @default(RECEIVED)
  payload           Json
  error             String?
  receivedAt        DateTime      @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?     @db.Timestamptz(3)

  paymentEvents PaymentTransaction[]

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("inbound_webhooks")
}

model FxRate {
  id         String   @id @default(uuid()) @db.Uuid
  base       String   @db.Char(3)
  quote      String   @db.Char(3)
  /// Units of quote per 1 unit of base. Display/conversion only, never stored money.
  rate       Decimal  @db.Decimal(20, 10)
  source     String   @db.VarChar(80)
  observedAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  payments Payment[]

  @@unique([base, quote, observedAt, source])
  @@index([base, quote, observedAt])
  @@map("fx_rates")
}

model TokenAllocation {
  id            String            @id @default(uuid()) @db.Uuid
  orderId       String            @unique @db.Uuid
  order         SubscriptionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offeringId    String            @db.Uuid
  offering      TokenOffering     @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  userId        String            @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId      String?           @db.Uuid
  wallet        Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  tokens        BigInt
  status        AllocationStatus  @default(PENDING)
  chainId       Int?
  txHash        String?           @db.VarChar(66)
  blockNumber   BigInt?
  attempts      Int               @default(0)
  failureReason String?
  mintedAt      DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([chainId, txHash])
  @@index([offeringId, status])
  @@index([userId])
  @@map("token_allocations")
}

/// Register of economic holders per offering (beneficiary / TK investor register).
model Investment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  offeringId      String        @db.Uuid
  offering        TokenOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  tokens          BigInt
  investedAmount  BigInt
  firstInvestedAt DateTime      @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  distributionAllocations DistributionAllocation[]

  @@unique([userId, offeringId])
  @@index([offeringId])
  @@map("investments")
}

// -----------------------------------------------------------------------------
// Operations: income, expenses, distributions
// -----------------------------------------------------------------------------

model RentalIncome {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @db.Uuid
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// First day of the month the rent relates to.
  periodMonth      DateTime @db.Date
  amount           BigInt
  unitLabel        String?  @db.VarChar(40)
  receivedAt       DateTime @db.Timestamptz(3)
  sourceDocumentId String?  @db.Uuid
  recordedById     String?  @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, periodMonth])
  @@map("rental_income")
}

model PropertyExpense {
  id                String          @id @default(uuid()) @db.Uuid
  propertyId        String          @db.Uuid
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category          ExpenseCategory
  amount            BigInt
  incurredAt        DateTime        @db.Date
  description       String          @db.VarChar(255)
  invoiceDocumentId String?         @db.Uuid
  recordedById      String?         @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([propertyId, incurredAt])
  @@map("property_expenses")
}

model Distribution {
  id                 String             @id @default(uuid()) @db.Uuid
  offeringId         String             @db.Uuid
  offering           TokenOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  isDemo             Boolean            @default(false)
  periodStart        DateTime           @db.Date
  periodEnd          DateTime           @db.Date
  status             DistributionStatus @default(DRAFT)
  grossIncome        BigInt
  operatingExpenses  BigInt
  taxes              BigInt
  reserveAllocation  BigInt             @default(0)
  fees               BigInt
  /// CHECK: = grossIncome − operatingExpenses − taxes − reserveAllocation − fees, ≥ 0
  distributableAmount BigInt
  /// Holdings are frozen at this instant (and block, once on-chain).
  recordDate         DateTime?          @db.Timestamptz(3)
  snapshotBlock      BigInt?
  paymentDate        DateTime?          @db.Date
  preparedById       String?            @db.Uuid
  approvedById       String?            @db.Uuid
  approvedAt         DateTime?          @db.Timestamptz(3)
  paidAt             DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  allocations DistributionAllocation[]

  @@unique([offeringId, periodStart, periodEnd])
  @@index([status, paymentDate])
  @@map("distributions")
}

model DistributionAllocation {
  id               String                       @id @default(uuid()) @db.Uuid
  distributionId   String                       @db.Uuid
  distribution     Distribution                 @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  userId           String                       @db.Uuid
  user             User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  investmentId     String                       @db.Uuid
  investment       Investment                   @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  tokensAtRecord   BigInt
  grossAmount      BigInt
  withholdingTaxBps Int                         @default(0)
  withholdingTax   BigInt                       @default(0)
  netAmount        BigInt
  status           DistributionAllocationStatus @default(PENDING)
  holdReason       String?
  paymentId        String?                      @db.Uuid
  payment          Payment?                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paidAt           DateTime?                    @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @db.Timestamptz(3)

  @@unique([distributionId, userId])
  @@index([userId])
  @@map("distribution_allocations")
}

// -----------------------------------------------------------------------------
// Secondary market (disabled; simulated orders only — enforced by CHECK)
// -----------------------------------------------------------------------------

model SecondaryMarketOrder {
  id              String               @id @default(uuid()) @db.Uuid
  offeringId      String               @db.Uuid
  offering        TokenOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  userId          String               @db.Uuid
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  side            OrderSide
  tokens          BigInt
  pricePerToken   BigInt
  status          SecondaryOrderStatus @default(DRAFT)
  /// Must stay true until a licensed venue/intermediary is in place.
  isSimulated     Boolean              @default(true)
  lockupCheckedAt DateTime?            @db.Timestamptz(3)
  approvedById    String?              @db.Uuid
  approvedAt      DateTime?            @db.Timestamptz(3)
  expiresAt       DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  @@index([offeringId, side, status])
  @@index([userId])
  @@map("secondary_market_orders")
}

// -----------------------------------------------------------------------------
// Accounting ledger (double entry, balanced by trigger)
// -----------------------------------------------------------------------------

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Uuid
  /// e.g. "client_money:JPY", "investor_payable:<userId>", "fees_income"
  code        String            @unique @db.VarChar(120)
  name        String            @db.VarChar(160)
  type        LedgerAccountType
  currency    String            @default("JPY") @db.Char(3)
  offeringId  String?           @db.Uuid
  userId      String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  postings LedgerPosting[]

  @@index([offeringId])
  @@index([userId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  /// Idempotent business key, e.g. "payment:<id>:captured".
  externalKey String   @unique @db.VarChar(160)
  description String   @db.VarChar(255)
  occurredAt  DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  postings LedgerPosting[]

  @@map("journal_entries")
}

model LedgerPosting {
  id        String        @id @default(uuid()) @db.Uuid
  entryId   String        @db.Uuid
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId String        @db.Uuid
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Signed integer yen: debit positive, credit negative.
  amount    BigInt

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_postings")
}

// -----------------------------------------------------------------------------
// Activity, notifications, audit, idempotency
// -----------------------------------------------------------------------------

/// Investor-facing activity feed (dashboard "Transactions" tab and exports).
model Transaction {
  id                       String            @id @default(uuid()) @db.Uuid
  userId                   String            @db.Uuid
  user                     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  offeringId               String?           @db.Uuid
  offering                 TokenOffering?    @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  type                     TransactionType
  status                   TransactionStatus
  amount                   BigInt?
  tokens                   BigInt?
  reference                String            @db.VarChar(80)
  orderId                  String?           @db.Uuid
  paymentId                String?           @db.Uuid
  allocationId             String?           @db.Uuid
  distributionAllocationId String?           @db.Uuid
  occurredAt               DateTime          @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([type, reference])
  @@index([userId, occurredAt])
  @@map("transactions")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  type      String              @db.VarChar(60)
  title     String              @db.VarChar(200)
  body      String
  data      Json?
  readAt    DateTime?           @db.Timestamptz(3)
  sentAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Append-only (UPDATE/DELETE blocked by trigger) and hash-chained.
model AuditLog {
  id          BigInt    @id @default(autoincrement())
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  actorType   ActorType
  actorUserId String?   @db.Uuid
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String    @db.VarChar(80)
  entityType  String    @db.VarChar(60)
  entityId    String    @db.VarChar(80)
  before      Json?
  after       Json?
  requestId   String?   @db.VarChar(64)
  ipHash      String?   @db.Char(64)
  userAgent   String?   @db.VarChar(512)
  /// SHA-256(prevHash || canonical row); computed by the API.
  prevHash    String?   @db.Char(64)
  hash        String    @unique @db.Char(64)

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  key            String   @db.VarChar(80)
  scope          String   @db.VarChar(120)
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

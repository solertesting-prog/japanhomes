#!/usr/bin/env bash
# Japan Property Token — DEMO server helper (installed as /usr/local/bin/jpt).
#   sudo jpt update            pull the latest code, rebuild, migrate, restart
#   sudo jpt status            containers and the public URL
#   sudo jpt logs [service]    follow logs (api, web, caddy, db)
#   sudo jpt admin <email>     give an account the back-office role
#   sudo jpt backup            database dump to /opt/jpt-backups
#   sudo jpt domain <host>     serve a custom domain instead of <ip>.sslip.io
set -euo pipefail
DIR=/opt/jpt
STACK="$DIR/infra/lightsail"
ENV_FILE="$STACK/.env"
compose() { docker compose --project-directory "$STACK" -f "$STACK/docker-compose.yml" --env-file "$ENV_FILE" "$@"; }

rand_hex() { openssl rand -hex "$1"; }

ensure_env() {
  if [ ! -f "$ENV_FILE" ]; then
    umask 077
    cat > "$ENV_FILE" <<ENV
# Generated by jpt on $(date -u +%FT%TZ). Keep private; back it up with the database.
POSTGRES_PASSWORD=$(rand_hex 24)
IP_HASH_SECRET=$(rand_hex 32)
PII_ENCRYPTION_KEY=$(rand_hex 32)
KYC_WEBHOOK_SECRET=$(rand_hex 32)
PAYMENT_WEBHOOK_SECRET=$(rand_hex 32)
CUSTOM_DOMAIN=
SITE_HOST=
ENV
  fi
  # Host: custom domain if set, otherwise <public-ip>.sslip.io (free, works with Let's Encrypt).
  local custom ip host
  custom="$(grep -E '^CUSTOM_DOMAIN=' "$ENV_FILE" | cut -d= -f2-)"
  if [ -n "$custom" ]; then
    host="$custom"
  else
    ip="$(curl -fsS --max-time 10 https://checkip.amazonaws.com | tr -d '[:space:]')"
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Could not detect the public IP" >&2; exit 1; }
    host="${ip//./-}.sslip.io"
  fi
  sed -i "s/^SITE_HOST=.*/SITE_HOST=$host/" "$ENV_FILE"
}

site_host() { grep -E '^SITE_HOST=' "$ENV_FILE" | cut -d= -f2-; }

cmd_update() {
  if [ -d "$DIR/.git" ]; then git -C "$DIR" pull --ff-only; fi
  ensure_env
  echo "== building (first time takes 10-15 minutes on a small server)"
  compose --profile tools build
  compose up -d db
  echo "== migrating"
  compose run --rm migrate
  echo "== DEMO catalogue"
  compose run --rm seed
  compose up -d --remove-orphans
  docker image prune -f >/dev/null
  echo
  echo "Ready: https://$(site_host)  (the HTTPS certificate can take a minute the first time)"
}

cmd_status() {
  compose ps
  echo "URL: https://$(site_host)"
}

cmd_admin() {
  [ $# -ge 1 ] || { echo "usage: jpt admin <email> [ROLE]" >&2; exit 1; }
  compose run --rm staff --email "$1" --role "${2:-SUPER_ADMINISTRATOR}"
}

cmd_backup() {
  mkdir -p /opt/jpt-backups
  local f
  f="/opt/jpt-backups/jpt-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
  compose exec -T db pg_dump -U jpt jpt | gzip > "$f"
  chmod 600 "$f"
  find /opt/jpt-backups -name 'jpt-*.sql.gz' -mtime +14 -delete
  echo "Backup: $f"
}

cmd_domain() {
  [ $# -eq 1 ] || { echo "usage: jpt domain <host> (point its DNS A record to this server first)" >&2; exit 1; }
  sed -i "s/^CUSTOM_DOMAIN=.*/CUSTOM_DOMAIN=$1/" "$ENV_FILE"
  cmd_update
}

[ "$(id -u)" = "0" ] || { echo "Run with sudo" >&2; exit 1; }
case "${1:-}" in
  update) cmd_update ;;
  status) cmd_status ;;
  logs) shift; compose logs -f --tail 100 "$@" ;;
  admin) shift; cmd_admin "$@" ;;
  backup) cmd_backup ;;
  domain) shift; cmd_domain "$@" ;;
  *) sed -n '2,9p' "$0"; exit 1 ;;
esac

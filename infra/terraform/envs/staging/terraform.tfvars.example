# Copy to terraform.tfvars (git-ignored) and fill in.
region            = "ap-northeast-1"
domain_name       = "staging.example.jp"
certificate_arn   = "arn:aws:acm:ap-northeast-1:123456789012:certificate/xxxxxxxx"
alarm_email       = "ops@example.jp"
github_repository = "solertesting-prog/japanhomes"

# Placeholders for the very first apply (ECR repositories do not exist yet);
# the deploy workflow registers real task definitions afterwards.
api_image     = "public.ecr.aws/docker/library/node:22-alpine"
migrate_image = "public.ecr.aws/docker/library/node:22-alpine"
web_image     = "public.ecr.aws/docker/library/node:22-alpine"

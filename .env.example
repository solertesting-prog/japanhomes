# ---------------------------------------------------------------------------
# Japan Property Token — environment variables (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql://jpt:jpt_dev_password@localhost:54329/jpt
# Only for `pnpm --filter @jpt/database migrate:check` (CI drift check)
SHADOW_DATABASE_URL=postgresql://jpt:jpt_dev_password@localhost:54329/jpt_shadow
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# At least 32 random characters: `openssl rand -hex 32`
IP_HASH_SECRET=replace-with-openssl-rand-hex-32-output
# 64 hex chars (openssl rand -hex 32). Encrypts MFA secrets and PII. Production: from KMS.
PII_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
KYC_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32-output
PAYMENT_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32-output
APP_URL=http://localhost:3000
SESSION_TTL_HOURS=12
# Dev helpers (email outbox, simulated KYC result and payment). Refused in production.
ENABLE_DEV_ENDPOINTS=true
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

# --- Web (apps/web) ---------------------------------------------------------
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# api  = read from the NestJS API (default)
# demo = render the DEMO fixtures in-process (UI work without Postgres)
JPT_DATA_SOURCE=api
# Keep search engines out while data is fictional
JPT_ALLOW_INDEXING=false

# --- Regulated modules (docs/LEGAL_MODEL.md §6) -----------------------------
# Prototype modules are ON unless set to false:
# JPT_ENABLE_PROPERTY_CATALOGUE=true
# JPT_ENABLE_INVESTMENT_SIMULATOR=true
# JPT_ENABLE_SIMULATED_SUBSCRIPTIONS=true
#
# Regulated modules are OFF. Turning one on REQUIRES its approval reference,
# otherwise the API refuses to start:
# JPT_ENABLE_REAL_SUBSCRIPTIONS=false
# JPT_APPROVAL_REF_REAL_SUBSCRIPTIONS=
#
# SECONDARY_MARKET and STABLECOIN_PAYMENTS are BLOCKED and cannot be enabled here.

# --- Seed -------------------------------------------------------------------
# Seeding DEMO data with NODE_ENV=production is refused unless:
# JPT_ALLOW_DEMO_SEED=true

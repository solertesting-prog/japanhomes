{
  "name": "japan-property-token",
  "private": true,
  "version": "0.1.0",
  "description": "Japan Property Token — tokenized Japanese real estate investment platform (prototype, DEMO data only)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @jpt/database exec prisma generate",
    "db:migrate": "pnpm --filter @jpt/database exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @jpt/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @jpt/database run seed",
    "db:studio": "pnpm --filter @jpt/database exec prisma studio",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d postgres redis",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
